{"schemaVersion": "docquery-n5.3-a1-answer-pilot-v1", "caseId": "mmlongbench-r3-1032", "sourceRowIndex": 1032, "sourceDomain": "Financial report", "answerFormat": "Float", "referenceAnswer": "253.3", "question": "What amount did  personnel-related costs increase for Netfilx in 2015? Answer in millions.", "mode": "HYBRID", "topK": 10, "http": {"ok": true, "httpStatus": 200, "requestId": "317aef43-ff07-40e5-b183-75bcf1888050", "latencyMs": 13830.659, "finalAttemptLatencyMs": 13830.659, "attemptCount": 1, "attempts": [{"ok": true, "httpStatus": 200, "requestId": "317aef43-ff07-40e5-b183-75bcf1888050", "latencyMs": 13830.659}]}, "response": {"queryExecutionId": "23ef61c0-147d-4272-8d61-5431f57c759b", "status": "ANSWERED", "answer": "Personnel-related costs increased by $133.2 million in 2015 [E23].", "requestedMode": "HYBRID", "executedMode": "HYBRID", "degraded": false, "degradationReason": null, "citations": [{"evidenceId": "E23", "documentKey": "mmlongbench-af042068d3845d87e107", "documentName": "NETFLIX_2015_10K.pdf", "headingPath": ["NETFLIX_2015_10K.pdf"], "blockId": "113:b:000327", "text": "The increase in technology and development expenses was primarily due to a $133.2 million increase in personnel-related costs resulting from an increase in compensation for existing employees and a 20% growth in average headcount supporting continued improvements in our streaming service and our international expansion. In addition, third party expenses, including costs associated with cloud computing, increased $23.8 million.", "truncated": false, "pageNumber": 24}]}, "metrics": {"answered": true, "controlledRefusal": false, "citationCount": 1, "hasRelevantDocumentCitation": true, "anyGoldPageCitation": true, "goldPageCitationCoverage": 1.0, "allGoldPagesCited": true, "printedGoldPages": [24], "physicalGoldPages": [24], "citedPhysicalGoldPages": [24], "automaticReferenceMatch": false, "referenceItemRecall": null, "referenceOrderMatch": null}}
{"schemaVersion": "docquery-n5.3-a1-answer-pilot-v1", "caseId": "mmlongbench-r3-1062", "sourceRowIndex": 1062, "sourceDomain": "Financial report", "answerFormat": "Float", "referenceAnswer": "3.0", "question": "what amount is liabilities for unredeemed gift cards in FY2017 for Amazon? Answer in billion.", "mode": "HYBRID", "topK": 10, "http": {"ok": true, "httpStatus": 200, "requestId": "fcd63c23-4b48-41d3-8080-d5d4854889cd", "latencyMs": 1103.498, "finalAttemptLatencyMs": 1103.498, "attemptCount": 1, "attempts": [{"ok": true, "httpStatus": 200, "requestId": "fcd63c23-4b48-41d3-8080-d5d4854889cd", "latencyMs": 1103.498}]}, "response": {"queryExecutionId": "1aa4d389-eb6b-4cb9-b084-005792d83c81", "status": "ANSWERED", "answer": "Amazon's liabilities for unredeemed gift cards as of December 31, 2017 was $3.0 billion [E4].", "requestedMode": "HYBRID", "executedMode": "HYBRID", "degraded": false, "degradationReason": null, "citations": [{"evidenceId": "E4", "documentKey": "mmlongbench-e525fdbb1913202fa249", "documentName": "AMAZON_2017_10K.pdf", "headingPath": ["AMAZON_2017_10K.pdf", "AMAZON.COM,INC. NOTESTOCONSOLIDATEDFINANCIALSTATEMENTS"], "blockId": "109:b:000582", "text": "As of December 31, 2016 and 2017 , our liabilities for unredeemed gift cards was $2.4 billion and $3.0 billion . We reduce the liability for a gift card when redeemed by a customer. If a gift card is not redeemed, we recognize revenue when it expires or when the likelihood of its redemption becomes remote, generally two years from the date of issuance.", "truncated": false, "pageNumber": 48}]}, "metrics": {"answered": true, "controlledRefusal": false, "citationCount": 1, "hasRelevantDocumentCitation": true, "anyGoldPageCitation": true, "goldPageCitationCoverage": 1.0, "allGoldPagesCited": true, "printedGoldPages": [48], "physicalGoldPages": [48], "citedPhysicalGoldPages": [48], "automaticReferenceMatch": true, "referenceItemRecall": null, "referenceOrderMatch": null}}
