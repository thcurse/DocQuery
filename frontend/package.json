{
  "name": "docquery-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src *.ts *.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:dev-guard": "node --test scripts/dev-guard.check.mjs"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.104.0",
    "naive-ui": "2.45.3",
    "pinia": "3.0.4",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.7",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.4.6",
    "bcryptjs": "3.0.3",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.7.0",
    "jsdom": "26.1.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vite": "8.3.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.2.4"
  }
}
